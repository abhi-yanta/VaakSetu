# Copy to .env and fill in locally. Never commit real keys.
#   Copy-Item .env.example .env
# Run: .\tool\run_with_env.ps1  (passes these as --dart-define)

# Bhashini Layer 1 TTS (ULCA): userID + ulcaApiKey (Udyat) + Authorization (Inference)
BHASHINI_USER_ID=
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=

# Optional — HuggingFace Layer 2 fallback (ai4bharat/indic-parler-tts)
HF_TOKEN=
